# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=chat.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://chat.example.com

# The production frontend is normally served from the same origin.
DJANGO_FRONTEND_BASE_URL=

# Keep empty for a same-origin frontend unless cross-origin access is
# intentionally required.
DJANGO_CORS_ALLOWED_ORIGINS=

DJANGO_SECURE_SSL_REDIRECT=True

# Start at 0 while HTTPS deployment is being verified.
# Raise deliberately after HTTPS is confirmed stable.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

DJANGO_LOG_LEVEL=INFO
DJANGO_MEDIA_ROOT=/srv/communication-platform/shared/media

# PostgreSQL (local/private only)
POSTGRES_DB=communication_platform
POSTGRES_USER=communication_platform
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Intentionally disabled under Daphne/ASGI.
POSTGRES_CONN_MAX_AGE=0

# Redis / Channels (local/private only)
REDIS_URL=redis://127.0.0.1:6379/0

# Message attachments
MESSAGE_ATTACHMENT_MAX_SIZE_BYTES=10485760
MESSAGE_MAX_ATTACHMENTS=5
USER_AVATAR_MAX_SIZE_BYTES=5242880
USER_AVATAR_MAX_DIMENSION=4096

# Optional email configuration.
# Communication Platform does not currently send application email.
# DJANGO_EMAIL_HOST=127.0.0.1
# DJANGO_EMAIL_PORT=25
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=False
# DJANGO_EMAIL_USE_SSL=False
# DJANGO_EMAIL_TIMEOUT=10
# DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost
# DJANGO_SERVER_EMAIL=root@localhost

# Voice / LiveKit
# Keep disabled until the self-hosted LiveKit deployment is ready.
VOICE_ENABLED=False
# Browser/native-client signaling endpoint through Nginx TLS.
# LIVEKIT_URL=wss://voice.example.com
# Private server-to-server RoomService endpoint. Keep local when LiveKit runs
# on the same VPS so authorization revocation does not depend on public DNS.
# LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
# LIVEKIT_API_KEY=change-me
# LIVEKIT_API_SECRET=change-me
VOICE_LIVEKIT_TOKEN_TTL_SECONDS=60
VOICE_LIVEKIT_ADMIN_TIMEOUT_SECONDS=2
VOICE_DIRECT_CALL_RING_TIMEOUT_SECONDS=45
