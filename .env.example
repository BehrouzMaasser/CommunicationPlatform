# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_FRONTEND_BASE_URL=http://127.0.0.1:5173

# PostgreSQL
POSTGRES_DB=communication_platform
POSTGRES_USER=communication_platform
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Channels
REDIS_HOST=localhost
REDIS_PORT=6379

# Message attachments
MESSAGE_ATTACHMENT_MAX_SIZE_BYTES=10485760
MESSAGE_MAX_ATTACHMENTS=5

# Voice / LiveKit (local development)
# Start LiveKit locally with `livekit-server --dev` before enabling voice.
VOICE_ENABLED=False
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
VOICE_LIVEKIT_TOKEN_TTL_SECONDS=60
VOICE_LIVEKIT_ADMIN_TIMEOUT_SECONDS=2
VOICE_DIRECT_CALL_RING_TIMEOUT_SECONDS=45
