# Example Nginx site for Communication Platform.
#
# Replace chat.example.com with the actual production hostname(s).
#
# This example matches the established V1 VPS layout:
#
#   /srv/communication-platform/app                  Git checkout
#   /srv/communication-platform/app/frontend/dist    React production build
#   /srv/communication-platform/app/backend/staticfiles
#                                                    Django collectstatic output
#   /srv/communication-platform/shared/media         private attachment storage
#
# IMPORTANT:
# /media/ must NOT expose DJANGO_MEDIA_ROOT. Message attachments are private
# application resources and are downloaded through Django's authorization-
# checked attachment API.

server {
    listen 80;
    listen [::]:80;

    server_name chat.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name chat.example.com;

    ssl_certificate /etc/letsencrypt/live/chat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.com/privkey.pem;

    # If Certbot manages TLS on the server, keep its generated include/dhparam
    # lines as appropriate for that deployment.
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /srv/communication-platform/app/frontend/dist;
    index index.html;

    # V1 defaults permit 5 attachments x 10 MiB each. Keep the proxy request
    # limit above the maximum multipart request size. Revisit this value if
    # MESSAGE_ATTACHMENT_MAX_SIZE_BYTES or MESSAGE_MAX_ATTACHMENTS changes.
    client_max_body_size 55m;

    # Django collected static files.
    location /static/ {
        alias /srv/communication-platform/app/backend/staticfiles/;
    }

    # Never expose private attachment storage directly.
    location /media/ {
        return 404;
    }

    # Django REST API.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django account/session pages.
    location /accounts/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional Django admin.
    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django Channels / WebSockets.
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # React Router SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
