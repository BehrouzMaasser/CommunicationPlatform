# Example Nginx site for Communication Platform.
#
# Replace chat.example.com with the actual production hostname(s).
# This file assumes the repository lives at /srv/communication-platform.
#
# IMPORTANT: /media/ is intentionally NOT served by Nginx. Message attachments
# are private application resources and must be downloaded through Django's
# authorization-checked attachment endpoint.

server {
    listen 80;
    listen [::]:80;

    server_name chat.example.com;

    # Keep HTTP only long enough to obtain/verify TLS, then redirect to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name chat.example.com;

    # Configure certificates according to the TLS tooling used on the server.
    ssl_certificate /etc/letsencrypt/live/chat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.com/privkey.pem;

    # React production build.
    root /srv/communication-platform/frontend/dist;
    index index.html;

    # V1 permits up to 5 x 10 MiB attachments per message by default. Keep this
    # above the maximum multipart request size, and revisit it if the Django
    # attachment limits are changed.
    client_max_body_size 55m;

    # Django collected static files (account pages/admin/static assets).
    location /static/ {
        alias /srv/communication-platform/backend/staticfiles/;
        access_log off;
        expires 7d;
    }

    # Never expose private attachment storage directly.
    location /media/ {
        return 404;
    }

    # Django REST API.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django-rendered authentication/account pages.
    location /accounts/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional Django admin. Remove this block and disable the route separately
    # if the production deployment should not expose Django admin at all.
    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Authenticated Channels WebSocket endpoint.
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }

    # React Router SPA fallback. Requests for real frontend files are served as
    # files; application routes fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
