[Unit]
Description=Communication Platform Daphne ASGI service
After=network.target
Wants=network.target

[Service]
Type=simple

# Use the account that owns/runs the application on the VPS. A dedicated
# unprivileged service account is recommended.
User=communication-platform
Group=communication-platform

WorkingDirectory=/srv/communication-platform/backend
EnvironmentFile=/srv/communication-platform/.env.production

ExecStart=/srv/communication-platform/.venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8000 \
    config.asgi:application

Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

# Python should write logs to stdout/stderr; systemd/journald captures them.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
